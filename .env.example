# Copy this file to .env and fill in real values. .env is gitignored --
# never commit real API keys.
#
# Everything here is optional. VISORA works with zero, one, two, or
# three AI providers configured -- any unconfigured slot is simply
# skipped by the fallback chain, and if every slot is unconfigured (or
# all configured providers fail), VISORA falls back to insights
# generated directly from its own analytical engine.
#
# Supported provider TYPE values:
#   openai_compatible -- OpenAI, Groq, OpenRouter, Together, Fireworks,
#                        DeepSeek, Mistral, local Ollama, NVIDIA Nemotron (NIM), ...
#   anthropic         -- Anthropic's native Messages API (Claude)
#   gemini            -- Google Gemini API (generativelanguage.googleapis.com)
#   nemotron          -- NVIDIA Nemotron via NIM (integrate.api.nvidia.com)
#
# BASE_URL is optional for well-known providers -- it defaults per TYPE --
# but required for most OpenAI-compatible third-party providers.
# LABEL is optional -- shown in UI instead of the type/model name.

# --- Upload / AI context size policy (both optional, shown at defaults) ---
# VISORA_MAX_UPLOAD_MB=150
# VISORA_AI_CONTEXT_LIMIT_MB=100
# VISORA_AI_TIMEOUT_SECONDS=30

# --- Provider 1 (OpenRouter example) ---
PROVIDER_1_TYPE=openai_compatible
PROVIDER_1_API_KEY=
PROVIDER_1_MODEL=openai/gpt-4o-mini
PROVIDER_1_BASE_URL=https://openrouter.ai/api/v1
# PROVIDER_1_LABEL=OpenRouter

# --- Provider 2 (Google Gemini example) ---
PROVIDER_2_TYPE=gemini
PROVIDER_2_API_KEY=
PROVIDER_2_MODEL=gemini-1.5-flash
# PROVIDER_2_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# PROVIDER_2_LABEL=Google Gemini

# --- Provider 3 (NVIDIA Nemotron example) ---
PROVIDER_3_TYPE=nemotron
PROVIDER_3_API_KEY=
PROVIDER_3_MODEL=nvidia/nemotron-3-ultra
# PROVIDER_3_BASE_URL=https://integrate.api.nvidia.com/v1
# PROVIDER_3_LABEL=NVIDIA Nemotron